# Copy this file to .env on the VPS and fill it from Firebase project settings.
# This file is ignored by Git. Do not commit the real .env file.
APP_PORT=80

# Firebase web app configuration (public client configuration; injected at build time)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=clinica-chutro.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=clinica-chutro
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=clinica-chutro.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
