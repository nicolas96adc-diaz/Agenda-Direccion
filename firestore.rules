rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Operational tasks for Clínica Chutro (requires real team authentication)
    match /tasks/{taskId} {
      allow read, write: if isSignedIn() && isValidId(taskId);
    }

    // Memorias y notas del equipo (requiere autenticación real del personal)
    match /notes/{noteId} {
      allow read, write: if isSignedIn() && isValidId(noteId);
    }

    match /memorias/{memoriaId} {
      allow read, write: if isSignedIn() && isValidId(memoriaId);
    }

    match /conversaciones/{conversacionId} {
      allow read, write: if isSignedIn() && isValidId(conversacionId);
    }

    // User profiles & presence (requires real team authentication)
    match /users/{userId} {
      allow read, write: if isSignedIn() && isValidId(userId);
    }

    // Patients collection (requires real team authentication)
    match /pacientes/{pacienteId} {
      allow read, write: if isSignedIn() && isValidId(pacienteId);
    }

    // Medical appointments collection (requires real team authentication)
    match /turnos/{turnoId} {
      allow read, write: if isSignedIn() && isValidId(turnoId);
    }

    // Connection test document (requires real team authentication)
    match /test/{docId} {
      allow read, write: if isSignedIn() && isValidId(docId);
    }

    // Default catch-all: reject everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
