rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveTeamMember() {
      return hasProfile()
        && profile().active == true
        && profile().uid == request.auth.uid;
    }

    function isAdmin() {
      return isActiveTeamMember() && profile().appUserId == 'user-rodrigo';
    }

    function isOperations() {
      return isActiveTeamMember()
        && profile().appUserId in ['user-nicolas', 'user-noemi'];
    }

    function isAvailable(data) {
      return !('assigneeUid' in data)
        || data.assigneeUid == null
        || data.assigneeUid == '';
    }

    match /tasks/{taskId} {
      function taskChangesOnly(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
      }

      function canClaimTask() {
        return isAvailable(resource.data)
          && ('assigneeUid' in request.resource.data)
          && request.resource.data.assigneeUid == request.auth.uid
          && ('assigneeId' in request.resource.data)
          && request.resource.data.assigneeId == profile().appUserId
          && ('assignee' in request.resource.data)
          && request.resource.data.assignee == profile().name
          && taskChangesOnly([
            'status',
            'assignee',
            'assigneeId',
            'assigneeUid',
            'lastModifiedBy',
            'lastModifiedById',
            'lastModifiedByUid',
            'updatedAt',
            'auditLog'
          ]);
      }

      function canEditOwnTask() {
        return resource.data.status != 'RESUELTA'
          && request.resource.data.status != 'RESUELTA'
          && (
            (
              ('assigneeUid' in resource.data)
              && resource.data.assigneeUid == request.auth.uid
            )
            || (
              isAvailable(resource.data)
              && ('createdByUid' in resource.data)
              && resource.data.createdByUid == request.auth.uid
              && isAvailable(request.resource.data)
            )
          )
          && taskChangesOnly([
            'title',
            'description',
            'priority',
            'status',
            'dueDate',
            'dueTime',
            'blockReason',
            'lastModifiedBy',
            'lastModifiedById',
            'lastModifiedByUid',
            'updatedAt',
            'auditLog'
          ]);
      }

      allow read: if isActiveTeamMember() && isValidId(taskId);

      allow create: if isActiveTeamMember()
        && isValidId(taskId)
        && request.resource.data.id == taskId
        && ('createdByUid' in request.resource.data)
        && request.resource.data.createdByUid == request.auth.uid
        && isAvailable(request.resource.data)
        && request.resource.data.status == 'PENDIENTE'
        && (
          !('inFocus' in request.resource.data)
          || request.resource.data.inFocus == false
          || isAdmin()
          || isOperations()
        );

      allow update: if isActiveTeamMember()
        && isValidId(taskId)
        && (
          isAdmin()
          || isOperations()
          || canClaimTask()
          || canEditOwnTask()
        );

      allow delete: if isAdmin() && isValidId(taskId);
    }

    match /notes/{noteId} {
      allow read, create, update, delete: if isActiveTeamMember() && isValidId(noteId);
    }

    match /users/{userId} {
      allow read: if isActiveTeamMember() && userId == request.auth.uid;
      allow write: if false;
    }

    match /test/{docId} {
      allow read, write: if isActiveTeamMember() && isValidId(docId);
    }

    match /memorias/{document=**} {
      allow read, write: if false;
    }

    match /conversaciones/{document=**} {
      allow read, write: if false;
    }

    match /pacientes/{document=**} {
      allow read, write: if false;
    }

    match /turnos/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
