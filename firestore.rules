rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return hasProfile() && profile().active == true; }
    function appUserId() { return active() && ('appUserId' in profile()) ? profile().appUserId : ''; }
    function admin() { return active() && appUserId() == 'user-rodrigo'; }
    function operations() { return active() && appUserId() in ['user-nicolas', 'user-noemi']; }
    function privileged() { return admin() || operations(); }
    // Authorization uses stable app identities, never profile role labels.
    function canDerive() { return active() && appUserId() in ['user-rodrigo', 'user-nicolas', 'user-noemi']; }

    function has(data, key) { return data.keys().hasAll([key]); }
    function canonicalAssignee(data) { return has(data, 'assigneeUid') && data.assigneeUid != null && data.assigneeUid != ''; }
    // assigneeId alone is residual legacy metadata, not an assignment.
    function unassigned(data) {
      return !canonicalAssignee(data) && (!has(data, 'assignee') || data.assignee == null ||
        data.assignee in ['', 'Disponible', 'disponible', 'Sin asignar', 'sin asignar', 'Sin responsable', 'sin responsable']);
    }
    function validStatus(data) { return has(data, 'status') && data.status in ['PENDIENTE', 'EN_PROCESO', 'BLOQUEADA', 'RESUELTA']; }
    function validPriority(data) { return has(data, 'priority') && data.priority in ['NORMAL', 'CRITICA']; }
    function actor(data) { return has(data, 'lastModifiedByUid') && data.lastModifiedByUid == request.auth.uid && has(data, 'updatedAt'); }
    // Legacy ownership can use appUserId; visible names are display-only.
    function owns(data) {
      return (canonicalAssignee(data) && data.assigneeUid == request.auth.uid) ||
        (!canonicalAssignee(data) && has(data, 'assigneeId') && data.assigneeId == appUserId());
    }
    function immutableTask() {
      return (!has(resource.data, 'id') || (has(request.resource.data, 'id') && request.resource.data.id == resource.data.id)) &&
        (!has(resource.data, 'createdAt') || (has(request.resource.data, 'createdAt') && request.resource.data.createdAt == resource.data.createdAt));
    }
    function groupMeeting(data) { return has(data, 'kind') && data.kind == 'REUNION_GRUPO'; }
    function validGroupMeeting(data) {
      return groupMeeting(data) && has(data, 'organizerUid') && data.organizerUid == request.auth.uid &&
        has(data, 'organizerName') && data.organizerName == profile().name && has(data, 'organizerId') && data.organizerId == appUserId() &&
        canonicalAssignee(data) && data.assigneeUid == request.auth.uid;
    }
    function keepsMeetingOrganizer() {
      return request.resource.data.organizerUid == resource.data.organizerUid && request.resource.data.organizerName == resource.data.organizerName &&
        request.resource.data.organizerId == resource.data.organizerId && request.resource.data.assigneeUid == resource.data.assigneeUid &&
        request.resource.data.createdByUid == resource.data.createdByUid;
    }
    function sameAssigneeUid() {
      return (!has(resource.data, 'assigneeUid') && !has(request.resource.data, 'assigneeUid')) ||
        (has(resource.data, 'assigneeUid') && has(request.resource.data, 'assigneeUid') && resource.data.assigneeUid == request.resource.data.assigneeUid);
    }
    function sameAssigneeId() {
      return (!has(resource.data, 'assigneeId') && !has(request.resource.data, 'assigneeId')) ||
        (has(resource.data, 'assigneeId') && has(request.resource.data, 'assigneeId') && resource.data.assigneeId == request.resource.data.assigneeId);
    }
    function sameAssigneeName() {
      return (!has(resource.data, 'assignee') && !has(request.resource.data, 'assignee')) ||
        (has(resource.data, 'assignee') && has(request.resource.data, 'assignee') && resource.data.assignee == request.resource.data.assignee);
    }
    function keepsAssignment() { return sameAssigneeUid() && sameAssigneeId() && sameAssigneeName(); }
    function assignmentFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'assigneeUid', 'assigneeId', 'assignee', 'status', 'priority',
        'lastModifiedBy', 'lastModifiedById', 'lastModifiedByUid', 'updatedAt', 'auditLog'
      ]);
    }
    function activeAssignee(data) {
      return canonicalAssignee(data) && exists(/databases/$(database)/documents/users/$(data.assigneeUid)) &&
        get(/databases/$(database)/documents/users/$(data.assigneeUid)).data.active == true;
    }
    function validAssignmentWrite() {
      return assignmentFieldsOnly() && actor(request.resource.data) && validStatus(request.resource.data) &&
        validPriority(request.resource.data) && activeAssignee(request.resource.data);
    }
    function claim() {
      return unassigned(resource.data) && validAssignmentWrite() && request.resource.data.assigneeUid == request.auth.uid &&
        request.resource.data.status in ['PENDIENTE', 'EN_PROCESO'];
    }
    function reassign() {
      return canDerive() && validAssignmentWrite() &&
        (!canonicalAssignee(resource.data) || resource.data.assigneeUid != request.resource.data.assigneeUid);
    }
    function release() { return !unassigned(resource.data) && unassigned(request.resource.data) && (privileged() || owns(resource.data)); }

    match /users/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || (active() && privileged()));
      allow list: if active() && canDerive();
      allow create, update, delete: if admin();
    }

    match /tasks/{taskId} {
      allow read: if active();
      allow create: if active() && has(request.resource.data, 'id') && request.resource.data.id == taskId &&
        validStatus(request.resource.data) && validPriority(request.resource.data) && actor(request.resource.data) &&
        has(request.resource.data, 'createdByUid') && request.resource.data.createdByUid == request.auth.uid &&
        ((!groupMeeting(request.resource.data) && unassigned(request.resource.data)) || validGroupMeeting(request.resource.data));
      allow update: if active() && immutableTask() && validStatus(request.resource.data) && validPriority(request.resource.data) &&
        actor(request.resource.data) && ((groupMeeting(resource.data) && groupMeeting(request.resource.data) &&
          (privileged() || owns(resource.data)) && keepsMeetingOrganizer()) || (!groupMeeting(resource.data) &&
          (claim() || reassign() || ((privileged() || owns(resource.data)) && (keepsAssignment() || release())))));
      allow delete: if privileged();
    }

    match /meetingAttendance/{attendanceId} {
      allow read: if active();
      allow create: if active() && has(request.resource.data, 'id') && request.resource.data.id == attendanceId &&
        has(request.resource.data, 'meetingId') && has(request.resource.data, 'attendeeUid') && request.resource.data.attendeeUid == request.auth.uid &&
        has(request.resource.data, 'attendeeName') && request.resource.data.attendeeName == profile().name && has(request.resource.data, 'confirmedAt') &&
        exists(/databases/$(database)/documents/tasks/$(request.resource.data.meetingId)) &&
        groupMeeting(get(/databases/$(database)/documents/tasks/$(request.resource.data.meetingId)).data) &&
        get(/databases/$(database)/documents/tasks/$(request.resource.data.meetingId)).data.organizerUid != request.auth.uid;
      allow update: if false;
      allow delete: if active() && resource.data.attendeeUid == request.auth.uid;
    }

    match /notes/{noteId} {
      allow read: if active();
      allow create: if active() && has(request.resource.data, 'authorUid') && request.resource.data.authorUid == request.auth.uid &&
        has(request.resource.data, 'authorName') && request.resource.data.authorName == profile().name &&
        (privileged() || (has(request.resource.data, 'userId') && (request.resource.data.userId == request.auth.uid || request.resource.data.userId == appUserId())));
      allow update: if active() && (privileged() || (has(resource.data, 'authorUid') && resource.data.authorUid == request.auth.uid &&
        has(resource.data, 'authorName') && resource.data.authorName == profile().name)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'color', 'isCompleted']);
      allow delete: if active() && (privileged() || (has(resource.data, 'userId') && (resource.data.userId == request.auth.uid || resource.data.userId == appUserId())));
    }

    match /releaseAcknowledgements/{acknowledgementId} {
      allow get: if active() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create: if active() && request.resource.data.uid == request.auth.uid && has(request.resource.data, 'version') &&
        acknowledgementId == request.auth.uid + '_' + request.resource.data.version && has(request.resource.data, 'acknowledgedAt');
      allow update, delete: if false;
    }

    match /memorias/{id} { allow read: if active(); allow write: if privileged(); }
    match /conversaciones/{id} { allow read, write: if privileged(); }
    match /{document=**} { allow read, write: if false; }
  }
}
